{
  "metadata": [
    {
      "src": [
        {
          "src": "bin/Release/net8.0-windows",
          "files": [
            "CADability.Forms.dll"
          ]
        }
      ],
      "dest": "api",
      "references": [
        {
          "src": "obj/docfx-refs",
          "files": [
            "*.dll"
          ]
        }
      ]
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**.yml",
          "api/index.md",
          "toc.yml",
          "*.md"
        ]
      }
    ],
    "dest": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appTitle": "CADability.Forms",
      "_appName": "CADability.Forms",
      "_enableSearch": true
    }
  }
}
