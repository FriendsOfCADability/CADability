<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageId>CADability</PackageId>
    <Version>1.2.1</Version>
    <!-- Update this for each publish -->
    <Authors>FriendsOfCADability</Authors>
    <Description>CAD functionality for .NET</Description>
    <RepositoryUrl>https://github.com/FriendsOfCADability/CADability</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>cad drawing winforms geometry netstandard net48</PackageTags>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>

    <BuildDocFx Condition=" '$(Configuration)'!='RelWithDoc' ">false</BuildDocFx>
    <Configurations>Debug;Release;RelWithDoc;WebDebug</Configurations>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>CADabilityKey.snk</AssemblyOriginatorKeyFile>
    <AssemblyName>CADability</AssemblyName>
    <Platforms>AnyCPU;x64</Platforms>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <LangVersion>12.0</LangVersion>

    <!-- Symbols and source stepping for consumers of the package: the symbols travel as a separate
         .snupkg to nuget.org's symbol server, and Source Link records the commit in the package and
         the source URLs in the pdb, so a debugger can fetch the matching sources from GitHub.
         The Release configuration builds portable pdbs for this - nuget.org rejects a .snupkg that
         carries Windows pdbs. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- generated files have no counterpart on GitHub, so they go into the pdb itself -->
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)'=='true'">
    <!-- normalizes the source paths baked into the pdb, so the published symbols do not depend on
         where the runner happened to check the repository out. Only on the build server: locally the
         real paths are what lets a debugger find the sources without downloading them. -->
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>NET4X;TRACE;DEBUG;xTESTNEWCONTEXTMENU, xUSENONPRIODICSURFACES</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='WebDebug'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>TRACE;xPARALLEL, xTESTNEWCONTEXTMENU, xUSENONPRIODICSURFACES, WEBASSEMBLY</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>NET4X;xTESTNEWCONTEXTMENU</DefineConstants>
    <Optimize>true</Optimize>
    <!-- portable, not full: a .snupkg may only contain portable pdbs -->
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <DocumentationFile />
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='RelWithDoc'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>xPARALLEL, xTESTNEWCONTEXTMENU</DefineConstants>
    <Optimize>false</Optimize>
    <!-- portable like Release: IncludeSymbols applies to every pack, and a .snupkg built from
         Windows pdbs would be rejected by nuget.org -->
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <DocumentationFile />
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <!-- exclusions -->
    <RemoveFiles Include="CADability.DXF\**" />
    <RemoveFiles Include="DXF\**" />
    <RemoveFiles Include="_site\**" />
    <RemoveFiles Include="OpenGlList.cs" />
    <RemoveFiles Include="Scripting.cs" />
    <RemoveFiles Include="Tangulation.cs" />
    <RemoveFiles Include="log.txt" />
    <RemoveFiles Include="_ToDo.txt" />
    <RemoveFiles Include="WebDrawing.cs" Condition="'$(Configuration)'!='WebDebug'" />

    <EmbeddedResource Remove="@(RemoveFiles)" />
    <EmbeddedFiles Remove="@(RemoveFiles)" />
    <Resource Remove="@(RemoveFiles)" />
    <Compile Remove="@(RemoveFiles)" />
    <Compile Remove="netDxf\**" />
    <Compile Remove="ParametricsExtrudeAction.cs" />
    <Compile Remove="ParametricsOffsetAction.cs" />
    <Compile Remove="ParametricsRadiusAction.cs" />
    <Compile Remove="SelectActionContextMenu.cs" />
    <Content Remove="@(RemoveFiles)" />
    <None Remove="@(RemoveFiles)" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="MenuResource.xml" />
    <EmbeddedResource Include="StringTableDeutsch.xml" />
    <EmbeddedResource Include="StringTableEnglish.xml" />
  </ItemGroup>

  <ItemGroup>
    <!-- ACadSharp comes from the FriendsOfCADability fork (submodule at external/ACadSharp),
         not from the nuget.org package. PrivateAssets="all" keeps it out of the CADability
         package dependencies; EmbedACadSharpInPackage below ships the fork-built dll instead. -->
    <ProjectReference Include="..\external\ACadSharp\src\ACadSharp\ACadSharp.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MathNet.Numerics.Signed" Version="5.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="6.0.0" />
    <!-- System.Memory is a runtime dependency of the embedded ACadSharp.dll (netstandard2.0) -->
    <PackageReference Include="System.Memory" Version="4.6.3" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="9.0.6" />
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);EmbedACadSharpInPackage</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>
  <Target Name="EmbedACadSharpInPackage">
    <ItemGroup>
      <BuildOutputInPackage Include="$(OutputPath)ACadSharp.dll" />
      <BuildOutputInPackage Include="$(OutputPath)ACadSharp.xml" Condition="Exists('$(OutputPath)ACadSharp.xml')" />
    </ItemGroup>
  </Target>

</Project>
