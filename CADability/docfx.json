{
  "metadata": [
    {
      "src": [
        {
          "src": "bin/Release/netstandard2.0",
          "files": [
            "CADability.dll"
          ]
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**.yml",
          "api/index.md",
          "articles/**.md",
          "articles/**/toc.yml",
          "toc.yml",
          "*.md"
        ]
      }
    ],
    "dest": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appTitle": "CADability",
      "_appName": "CADability",
      "_enableSearch": true
    }
  }
}
